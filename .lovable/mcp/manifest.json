{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://rcerbsywuovcleqybumg.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "baeshen-medical-mcp",
      "version": "0.1.0",
      "title": "Baeshen Medical MCP"
    },
    "tools": [
      {
        "name": "list_branches",
        "title": "List clinic branches",
        "description": "List all active branches of Baeshen Medical Complex with basic contact info (name, city, phone, address).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_doctors",
        "title": "List doctors",
        "description": "List active doctors at Baeshen Medical Complex. Optionally filter by branch slug or specialty slug. Returns up to 50 doctors per call.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "branch_slug": {
              "type": "string",
              "description": "Optional branch slug filter."
            },
            "specialty_slug": {
              "type": "string",
              "description": "Optional specialty slug filter."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max rows (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_appointments",
        "title": "List my appointments",
        "description": "List appointments visible to the signed-in user. Row-level security limits results to appointments the user is authorized to see.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_appointment",
        "title": "Create appointment",
        "description": "Create a new appointment. Requires an authenticated user; row-level security controls what can be inserted and read back. Date must be today or later.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "patient_name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120,
              "description": "Patient full name."
            },
            "patient_phone": {
              "type": "string",
              "minLength": 6,
              "maxLength": 32,
              "description": "Patient phone number."
            },
            "appointment_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Appointment date (YYYY-MM-DD)."
            },
            "appointment_time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$",
              "description": "Appointment time (HH:MM or HH:MM:SS)."
            },
            "doctor_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional doctor UUID."
            },
            "branch_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional branch UUID."
            },
            "specialty_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional specialty UUID."
            },
            "patient_email": {
              "type": "string",
              "format": "email",
              "description": "Optional patient email."
            },
            "reason": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional visit reason."
            }
          },
          "required": [
            "patient_name",
            "patient_phone",
            "appointment_date",
            "appointment_time"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_appointment_status",
        "title": "Cancel or confirm an appointment",
        "description": "Update an appointment's status to `cancelled` or `confirmed`. Row-level security decides who can do what: patients can cancel their own upcoming appointments (matched by phone); confirming an appointment requires staff (admin/reception) with branch access.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "appointment_id": {
              "type": "string",
              "format": "uuid",
              "description": "Appointment UUID to update."
            },
            "status": {
              "type": "string",
              "enum": [
                "cancelled",
                "confirmed"
              ],
              "description": "New status. `cancelled` for patients cancelling their own; `confirmed` for staff."
            }
          },
          "required": [
            "appointment_id",
            "status"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
